# Recovery OS — Environment Variables
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase or any PostgreSQL provider)
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:your_password_here@host:5432/recovery_os

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# ─── AI (OpenRouter) ────────────────────────────────────────────────────────
# OpenRouter API key — get one at https://openrouter.ai/keys
# Works with many models (GPT-4, Claude, Mistral, etc.)
# Leave empty to use the fallback friendly message (MVP-safe)
OPENROUTER_API_KEY=

# ─── CORS (optional) ──────────────────────────────────────────────────────────
# In production, set this to your Vercel frontend URL
# CORS_ORIGIN=https://your-frontend.vercel.app
